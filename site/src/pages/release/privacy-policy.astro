// /release/privacy-policy.html: the address in the app (credits_privacy_url) and in the Play
// Console from before the site, when GitHub Pages published docs/. Keep it until both point at
// /privacy/. It shows the whole English policy, not a redirect, so a reviewer following the old
// link reads the policy itself; its canonical sends search engines to /privacy/.
import Base from '../../layouts/Base.astro';
import PrivacyPolicy from '../../components/PrivacyPolicy.astro';
import { language, pagePath, defaultLang } from '../../i18n';

const t = language(defaultLang).strings;
---

<Base
  lang={defaultLang}
  menuPage="privacy"
  title={t.privacy.title}
  description={t.privacy.description}
  canonicalPath={pagePath(defaultLang, 'privacy')}
>
  <PrivacyPolicy lang={defaultLang} />
</Base>
