<?xml version="1.0" encoding="utf-8"?><!--
   The debug build's data extraction rules (API 31+): the recorded "Your turn" sessions under
   the app's external files directory are a child's audio and stay on this phone only, out of
   the cloud backup and of a transfer to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="sessions"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="sessions"/>
    </device-transfer>
</data-extraction-rules>
